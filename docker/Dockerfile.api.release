# 发布时构建（确认发布才执行；开发期一律本地直跑）。
# 底座均复用本地已有镜像（docker images 可查）：python:3.11-slim / node:20-alpine / nginx:latest。
# api/sandbox 不want nodejs；web 构建产物由 nginx 静态托管（compose.release 未包含，见 docs/release.md）。

ARG PYTHON_BASE=python:3.11-slim
FROM ${PYTHON_BASE}

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /srv/api
COPY api/pyproject.toml ./
COPY api/src ./src
RUN pip install --no-cache-dir uv && uv sync --no-dev 2>/dev/null || pip install --no-cache-dir -e .
EXPOSE 8000
CMD ["uvicorn", "src.main:app", "--host", "0.0.0.0", "--port", "8000"]
