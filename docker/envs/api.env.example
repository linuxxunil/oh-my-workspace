# api 服务示例（S2 落地；先占位，后续补 JWT/DB URL）
API_DATABASE_URL=postgresql+psycopg://app:app@localhost:5433/app
API_REDIS_URL=redis://localhost:6380/0
API_JWT_SECRET=change-me-in-local-env-only-32bytes-min
# 本地直跑自举建表（含 vector 扩展）；单测不受影响（默认关）
API_AUTO_MIGRATE=1
# 配 sandbox 服务后填 http://localhost:18091（空=本地执行）
API_SANDBOX_URL=
# provider api_key Fernet 主密钥（REQ-012）：44 字符 urlsafe-base64；生产必换。
# 生成：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
API_MASTER_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
