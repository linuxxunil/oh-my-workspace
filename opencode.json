{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow"
    }
  },
  "agent": {
    "plan": {
      "mode": "primary",
      "temperature": 0.1,
      "permission": {
        "edit": {
          "*": "deny",
          "docs/plans/**": "allow",
          "docs/requirements/**": "allow"
        },
        "bash": "deny"
      }
    },
    "build": {
      "mode": "primary",
      "temperature": 0.3,
      "permission": {
        "task": {
          "*": "deny",
          "tester": "allow"
        }
      }
    }
  }
}
